# ==============================================================================
# OpenRank CLI Environment Configuration Example
# Copy to .env or export in your shell to override default settings.
# ==============================================================================

# Custom directory path for local cached catalog index and pricing tables
# Default: $XDG_CACHE_HOME/openrank or ~/.cache/openrank
# OPENRANK_CACHE_DIR=/path/to/custom/cache

# Cache expiration TTL in seconds (Default: 86400 -> 24 hours)
# OPENRANK_CACHE_TTL=86400

# Set to 1 to disable ANSI color formatting (compliant with https://no-color.org)
# NO_COLOR=1
